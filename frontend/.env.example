# Relative URL uses Vite's local proxy, keeping the browser on the same origin.
VITE_API_BASE_URL=/api/v1
# Server-side Vite configuration only; never put secrets in VITE_* variables.
API_PROXY_TARGET=http://127.0.0.1:8000
# Public values only. Obtain the publishable key from Supabase project settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

