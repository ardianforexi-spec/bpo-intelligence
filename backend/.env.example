APP_ENV=development
LOG_LEVEL=INFO
# Leave blank to run the API without a database. Readiness then returns 503.
# Match your PostgreSQL credentials. URL-encode special characters in passwords.
# DATABASE_URL=postgresql+psycopg://bpo:YOUR_PASSWORD@127.0.0.1:5432/bpo_intelligence
DATABASE_URL=
# A small per-instance pool is suitable for an initial hosted deployment.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
# Supabase: use Connect > Session pooler, replace postgresql:// with
# postgresql+psycopg:// and require TLS. Keep actual credentials out of Git.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Reserved for subsequent phases; no provider calls exist in Phase 1.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RESEARCH_DAILY_LIMIT=20
SUPABASE_URL=https://ghqimzognkumxfybnucg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SEARCH_PROVIDER=
SEARCH_API_KEY=
APOLLO_API_KEY=

