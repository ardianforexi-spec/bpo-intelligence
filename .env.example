# Application
APP_ENV=development
APP_NAME=BPO Intelligence API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173

# PostgreSQL (local Docker defaults)
POSTGRES_DB=bpo_intelligence
POSTGRES_USER=bpo_user
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bpo_user:change-me-before-production@localhost:5432/bpo_intelligence

# Reserve for later phases. Do not commit real values.
OPENAI_API_KEY=
WEB_SEARCH_API_KEY=
APOLLO_API_KEY=
